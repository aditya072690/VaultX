generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS ====================
model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String
  firstName         String
  lastName          String
  avatar            String?
  timezone          String     @default("UTC")

  // Two-Factor Authentication
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?

  // Storage Management
  storageLimit      BigInt     @default(10737418240) // 10GB in bytes
  storageUsed       BigInt     @default(0)

  // Account Metadata
  onboardingCompleted Boolean    @default(false)
  onboardingCompletedAt DateTime?
  isFirstLogin        Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?
  deletedAt         DateTime?

  // Relations
  files             File[]
  folders           Folder[]
  publicLinks       PublicLink[]
  sharedFiles       SharedFile[] @relation("SharedByUser")
  receivedShares    SharedFile[] @relation("SharedWithUser")
  activityLogs      ActivityLog[]
  vaultSettings     VaultSettings?
  vaultAccessLogs   VaultAccessLog[]

  @@index([email])
  @@index([createdAt])
}

// ==================== FILES ====================
model File {
  id                String     @id @default(cuid())
  name              String
  mimeType          String
  size              BigInt
  s3Key             String     @unique
  md5Hash           String?

  // Access Control
  isPublic          Boolean    @default(false)
  isPrivate         Boolean    @default(false)

  // Lifecycle
  uploadedAt        DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  // Foreign Keys
  ownerId           String
  folderId          String?

  // Relations
  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder            Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  publicLinks       PublicLink[]
  sharedWith        SharedFile[]
  downloadLogs      DownloadLog[]

  @@index([ownerId])
  @@index([folderId])
  @@index([isPublic])
  @@index([isPrivate])
  @@index([deletedAt])
  @@index([uploadedAt])
}

// ==================== FOLDERS ====================
model Folder {
  id                String     @id @default(cuid())
  name              String
  isPublic          Boolean    @default(false)
  deletedAt         DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Foreign Keys
  ownerId           String
  parentFolderId    String?

  // Relations
  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent            Folder?    @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children          Folder[]   @relation("FolderHierarchy")
  files             File[]

  @@index([ownerId])
  @@index([parentFolderId])
  @@index([createdAt])
}

// ==================== PUBLIC LINKS ====================
model PublicLink {
  id                String     @id @default(cuid())
  token             String     @unique
  accessCount       Int        @default(0)
  expiresAt         DateTime?
  passwordHash      String?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Foreign Keys
  fileId            String
  userId            String

  // Relations
  file              File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([fileId])
  @@index([userId])
}

// ==================== SHARED FILES ====================
model SharedFile {
  id                String     @id @default(cuid())
  permission        String     @default("view") // 'view' | 'download' | 'upload'
  status            String     @default("active") // 'active' | 'pending' | 'rejected' | 'revoked'
  expiresAt         DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Foreign Keys
  fileId            String
  sharedById        String
  sharedWithId      String

  // Relations
  file              File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sharedBy          User       @relation("SharedByUser", fields: [sharedById], references: [id])
  sharedWith        User       @relation("SharedWithUser", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([fileId, sharedWithId])
  @@index([sharedById])
  @@index([sharedWithId])
  @@index([status])
}

// ==================== ACTIVITY LOG ====================
model ActivityLog {
  id                String     @id @default(cuid())
  action            String
  resourceType      String
  resourceId        String
  details           String?
  ipAddress         String?
  userAgent         String?

  createdAt         DateTime   @default(now())

  // Foreign Keys
  userId            String

  // Relations
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
  @@index([createdAt])
}

// ==================== DOWNLOAD LOG ====================
model DownloadLog {
  id                String     @id @default(cuid())
  ipAddress         String?
  userAgent         String?
  downloadedAt      DateTime   @default(now())

  // Foreign Keys
  fileId            String

  // Relations
  file              File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([downloadedAt])
}

// ==================== VAULT SETTINGS ====================
model VaultSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  vaultPin         String   // Hashed 6-digit PIN (bcryptjs)
  vaultPassword    String?  // Optional hashed backup password

  autoLockTimeout  Int      @default(1800) // 30 mins in seconds
  lockOnAppClose   Boolean  @default(true)
  lockOnInactivity Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==================== VAULT ACCESS LOG ====================
model VaultAccessLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  unlockedAt DateTime  @default(now())
  lockedAt   DateTime?
  method     String    // 'pin' | 'password'
  success    Boolean
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([unlockedAt])
}

