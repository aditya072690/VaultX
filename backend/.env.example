# Server Configuration
PORT=5001
NODE_ENV=production
LOG_LEVEL=info

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://vaultx_user:your_password@your_db_host:5432/vaultx_prod"

# JWT Authentication (generate 32+ char secrets using `openssl rand -base64 32`)
JWT_SECRET=your_32_character_jwt_secret_here
JWT_REFRESH_SECRET=your_32_character_jwt_refresh_secret_here
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# AWS S3 / Cloud Storage (Production)
STORAGE_MODE=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=vaultx-prod-storage

# Local Storage Fallback (Development only)
LOCAL_UPLOAD_DIR=./uploads

# CORS & Domain Configuration
FRONTEND_URL=https://vaultx.com

# File Limits & Quotas
MAX_FILE_SIZE=104857600